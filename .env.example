# Deployment Parameters
CONTAINER_NAME=bulwark-relay
SSH_USER=root
SSH_HOST=95.217.5.54
SSH_PORT=22
CADDY_NETWORK=nordible-net
REMOTE_APP_DIR=/opt/bulwark-relay
