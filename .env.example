# =============================================================================
# Nordible Mail Server Environment & Deployment Configuration
# =============================================================================

# Detailed Console Stacktraces & Debug Logging
RUST_BACKTRACE=1
RUST_LOG=debug
LOG=debug

# Server Settings
STALWART_PUBLIC_SIGNUP=true
STALWART_API_KEY=zGfQljuo3mUSAiY7TCOWLBlI
# CONFIG_PATH=/etc/stalwart/config.toml

# Marketing Site & Billing Integration
MARKETING_SITE_URL=http://172.23.16.1:3000

# Server Hostname & Public URL
NORDIBLEMAIL_HOSTNAME=ms1.nordible.co
NORDIBLEMAIL_PUBLIC_URL=https://ms1.nordible.co

# Deployment Parameters (Used by deploy.ps1)
CONTAINER_NAME=nordible-mail-server
