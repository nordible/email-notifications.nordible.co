# =============================================================================
# Bulwark Push Relay Configuration (Example)
# =============================================================================

PORT=3003
HOST=0.0.0.0
NODE_ENV=production
PUSH_DATA_DIR=/app/data

# Web Push (VAPID) Credentials
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
